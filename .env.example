# Clé API Google AI Studio (Gemini)
GEMINI_API_KEY=your_api_key_here

# Modèle Gemini Live utilisé pour la traduction.
# IMPORTANT : Seuls les modèles "gemini-*-live-translate-preview" supportent la translationConfig.
# Ne PAS utiliser gemini-2.0-flash-exp ou autre modèle générique ici.
GEMINI_MODEL=models/gemini-3.5-live-translate-preview

# Port du serveur (défaut: 3000)
PORT=3000

# Langues cibles pour la traduction (codes séparés par des virgules)
# Exemples: en,fr,es,pt,sw,ln
TARGET_LANGUAGES=en

# Nom de l'église (affiché sur l'interface publique)
CHURCH_NAME=Notre Église

# Mot de passe de la console d'administration (laissez vide pour désactiver l'authentification)
ADMIN_PASSWORD=your_admin_password_here
